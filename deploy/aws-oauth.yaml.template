apiVersion: v1
kind: ConfigMap
metadata:
  name: as-docs-ai-config
  namespace: as-docs
data:
  ENVIRONMENT: "$environment"
  PORT: "8000"
  OPENAI_MODEL: gpt-6-luna
  OPENAI_TEMPERATURE: "0"
  OPENAI_REASONING_EFFORT: none
  OPENAI_EMBEDDING_MODEL: text-embedding-3-small
  OPENAI_EMBEDDING_DIMENSIONS: "1536"
  AI_EMBEDDING_PROVIDER: $embedding_provider
  AI_CHAT_PROVIDER: $chat_provider
  REDIS_URL: redis://redis.as-docs.svc.cluster.local:6379/0
  AI_MCP_CLIENT_ENABLED: "true"
  AI_MCP_SERVER_URL: http://as-docs-backend.as-docs.svc.cluster.local:3000/mcp
  AI_MCP_CONNECT_MODE: legacy
  AI_RAG_TOP_K: "8"
  AI_RAG_MIN_SCORE: "0.66"
  AI_OAUTH_ENABLED: "true"
  AI_OIDC_ISSUER: $issuer
  AI_OIDC_AWS_LAB_HTTP: $lab_http
  AI_OIDC_JWKS_URL: $jwks
  AI_OIDC_CA_FILE: /etc/asdocs/keycloak-trust/ca.pem
  AI_OAUTH_CLIENTS_JSON: $clients
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: as-docs-ai-caddy
  namespace: as-docs
data:
  Caddyfile: |
    {
        admin off
        persist_config off
        auto_https off
        default_sni as-docs-ai.as-docs.svc.cluster.local
    }

    :8443 {
        tls /etc/asdocs/tls/tls.crt /etc/asdocs/tls/tls.key
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: as-docs-ai
  namespace: as-docs
spec:
  replicas: 2
  selector:
    matchLabels: { app: as-docs-ai }
  template:
    metadata:
      labels: { app: as-docs-ai }
      annotations:
        as-docs.ai/render-sha256: "$revision"
    spec:
      automountServiceAccountToken: false
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: { app: as-docs-ai }
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
      containers:
        - name: ai
          image: $ai_image
          command: [uvicorn]
          args: ["tcc_docs_ai.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"]
          envFrom:
            - configMapRef: { name: as-docs-ai-config }$openai_env
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          resources:
            requests: { cpu: 200m, memory: 384Mi }
            limits: { memory: 1Gi }
          livenessProbe:
            exec:
              command:
                - python
                - -c
                - 'from urllib.request import urlopen; urlopen("http://127.0.0.1:8000/health/live", timeout=2).close()'
            initialDelaySeconds: 5
            periodSeconds: 20
            timeoutSeconds: 3
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
            - { name: keycloak-trust, mountPath: /etc/asdocs/keycloak-trust, readOnly: true }
        - name: tls-proxy
          image: $caddy_image
          # A imagem oficial pode ter CAP_NET_BIND_SERVICE no binário. Copie
          # sem os atributos para rodar na 8443 com todas as capabilities removidas.
          command: [/bin/sh, -ec]
          args:
            - cp /usr/bin/caddy /config/caddy && exec /config/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
          ports:
            - { name: https-ai, containerPort: 8443, protocol: TCP }
          readinessProbe:
            httpGet: { path: /health/ready, port: https-ai, scheme: HTTPS }
            periodSeconds: 5
            timeoutSeconds: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          resources:
            requests: { cpu: 25m, memory: 48Mi }
            limits: { memory: 128Mi }
          volumeMounts:
            - { name: ai-tls, mountPath: /etc/asdocs/tls, readOnly: true }
            - { name: ai-tls-config, mountPath: /etc/caddy/Caddyfile, subPath: Caddyfile, readOnly: true }
            - { name: caddy-data, mountPath: /data }
            - { name: caddy-config, mountPath: /config }
      volumes:
        - name: ai-tls
          secret:
            secretName: as-docs-ai-oauth-tls
            defaultMode: 0440
            items:
              - { key: tls.crt, path: tls.crt }
              - { key: tls.key, path: tls.key }
        - name: keycloak-trust
          configMap:
            name: as-docs-keycloak-ai-trust
            items:
              - { key: ca.pem, path: ca.pem }
        - name: ai-tls-config
          configMap: { name: as-docs-ai-caddy }
        - { name: caddy-data, emptyDir: {} }
        - { name: caddy-config, emptyDir: {} }
        - { name: tmp, emptyDir: {} }
---
apiVersion: v1
kind: Service
metadata:
  name: as-docs-ai
  namespace: as-docs
spec:
  type: ClusterIP
  selector: { app: as-docs-ai }
  ports:
    - { name: https, port: 8443, targetPort: https-ai, protocol: TCP }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ai-ingress
  namespace: as-docs
spec:
  podSelector:
    matchLabels: { app: as-docs-ai }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: { matchLabels: { app: as-docs-backend } }
      ports:
        - { port: 8443, protocol: TCP }
