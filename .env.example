ENVIRONMENT=development

# --- Modelo -------------------------------------------------------------------
# Sem chave: deixe OPENAI_API_KEY vazio e use os provedores determinísticos
# abaixo (hashing + extractive). A escrita assistida exige chave real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Temperatura é fixa em 0 (requisito do TCC); outro valor é recusado no boot.
OPENAI_TEMPERATURE=0
# Modelos de raciocínio só aceitam temperatura com effort=none. Para um modelo sem
# raciocínio (ex.: gpt-4.1-mini) deixe vazio para omitir o parâmetro.
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# openai | hashing (hashing = desenvolvimento/testes sem chave)
AI_EMBEDDING_PROVIDER=hashing
AI_HASHING_EMBEDDING_DIMENSIONS=256
# openai | extractive (extractive = devolve trechos literais, sem LLM)
AI_CHAT_PROVIDER=extractive

# --- Consumidor (tcc-docs-app) -----------------------------------------------
# Deve ser igual a DOCS_AI_HMAC_SECRET no tcc-docs-app. Gere com: openssl rand -hex 32
DOCS_AI_HMAC_SECRET=replace-with-at-least-32-random-bytes

# --- Redis 8 (idempotência + banco vetorial) -----------------------------------
REDIS_URL=redis://localhost:6379/0
AI_IDEMPOTENCY_IN_PROGRESS_TTL_SECONDS=900
AI_IDEMPOTENCY_COMPLETED_TTL_SECONDS=86400

# --- Limites ------------------------------------------------------------------
AI_MAX_INPUT_TOKENS=500000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_PROPOSAL_OPERATIONS=40
AI_HMAC_MAX_CLOCK_SKEW_SECONDS=300
AI_CONNECTION_RETRIES=2
AI_MAX_EMBEDDING_INPUTS=100

# --- RAG ----------------------------------------------------------------------
AI_CHUNK_MAX_CHARS=1600
AI_RAG_TOP_K=8
AI_RAG_MIN_SCORE=0.66
AI_RAG_SIMILAR_MIN_SCORE=0.58
AI_RAG_MAX_SIMILAR=5
AI_RAG_MAX_FRESH_READS=3

# --- MCP (leitura de páginas no tcc-docs-app) ---------------------------------
# Liga a verificação de frescor e o mcp-read da página desatualizada.
AI_MCP_CLIENT_ENABLED=true
AI_MCP_SERVER_URL=http://localhost:3000/mcp
AI_MCP_CONNECT_MODE=legacy
AI_MCP_MAX_TOOL_CALLS=8
AI_MCP_CALL_TIMEOUT_SECONDS=10
AI_MCP_TOTAL_TIMEOUT_SECONDS=45
AI_MCP_MAX_RESULT_BYTES=200000
